<header>
  <%= render 'shared/homepage_header' %>
</header>
<main>

  <% if flash[:alert] %>
    <div id="error-modal" class="modal1 show">
      <div class="modal-content">
        <p class="modal1-errormessage">パスワードまたはメールアドレスが間違っています</p>
      </div>
    </div>
  <% end %>

  <div class="login-main-field">
  <h2 class="login-main-heading">ログイン</h2>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="login-email-field">
      <%= f.label :email, class: "login-email-heading-field" do %>
        メールアドレス<%= content_tag(:span, "*", class: "required-star") %>
      <% end %>
      <%= f.email_field :email, class: "login-email-write-field", autofocus: true, autocomplete: "email" %>
      <% if resource.errors[:email].any? %>
        <div class="error-message">
          <%= resource.errors.full_messages_for(:email).join(', ') %>
        </div>
      <% end %>
    </div>

    <div class="login-password-field">
      <%= f.label :password, class: "login-password-heading-field" do %>
        パスワード<%= content_tag(:span, "*", class: "required-star") %>
      <% end %>
      <%= f.password_field :password,class: "login-password-write-field", autocomplete: "current-password" %>
      <% if resource.errors[:password].any? %>
      <div class="error-message">
        <%= resource.errors.full_messages_for(:password).join(', ') %>
      </div>
      <% end %>
    </div>

    <div class="login-submit-field">
      <%= f.submit "ログイン",class: "login-submit" %>
    </div>
    <% end %>
    <div class="login-to-new-create-link-field">
      <%= link_to "新規作成", new_user_registration_path , class: "new-user-create-link" %>
    </div>
  </div>
  <div class="login-white-place">
  </div>
</main>
<footer>
    <%= render "shared/homepage_footer" %>
</footer>
