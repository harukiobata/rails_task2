<header>
  <%= render 'shared/homepage_header' %>
</header>
<main>
  <h1 class="account-main-header">設定</h1>

  <%= render 'shared/sidebar' %>

  <div class="profile-edit-main-content">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <h3 class="profile-edit-main-heading">アカウント</h3>
      
      <div class="account-edit-email-field">
        <%= f.label :email,class: "account-edit-email-heading" do %>
           メールアドレス<%= content_tag(:span, "*", class: "required-star") %>
        <% end %>
        <%= f.email_field :email,class: "account-edit-email-writing", autofocus: true, autocomplete: "email" %>
        <% if resource.errors[:email].any? %>
          <div class="error-message">
            <%= resource.errors.full_messages_for(:email).join(', ') %>
          </div>
      <% end %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div class="account-current-email-writing">
          Currently waiting confirmation for: <%= resource.unconfirmed_email %>
        </div>
      <% end %>

      <div class="account-edit-new-password-field">
        <%= f.label :password,class: "account-edit-new-password-heading" do %>
          パスワード<%= content_tag(:span, "*", class: "required-star") %>
        <% end %>
        <%= f.password_field :password,class: "account-edit-new-password-writing", autocomplete: "new-password" %>
        <% if resource.errors[:password].any? %>
          <div class="error-message">
            <%= resource.errors.full_messages_for(:password).join(', ') %>
          </div>
        <% end %>
      </div>

      <div class="account-edit-new-confirmation-password-field">
        <%= f.label :password_confirmation,class: "account-edit-new-confirmation-password-heading" do %>
          確認用パスワード<%= content_tag(:span, "*", class: "required-star") %>
        <% end %>
        <%= f.password_field :password_confirmation,class: "account-edit-new-confirmation-password-writing", autocomplete: "new-password" %>
        <% if resource.errors[:password_confimation].any? %>
          <div class="error-message">
            <%= resource.errors.full_messages_for(:password_confimation).join(', ') %>
          </div>
        <% end %>
      </div>

      <div class="account-edit-current-password-field">
        <%= f.label :current_password ,class: "account-edit-current-password-heading" do %>
          現在のパスワード<%= content_tag(:span, "*", class: "required-star") %>
        <% end %> 
        <%= f.password_field :current_password,class: "account-edit-current-password-writing", autocomplete: "current-password" %>
        <% if resource.errors[:current_password].any? %>
          <div class="error-message">
            <%= resource.errors.full_messages_for(:current_password).join(', ') %>
          </div>
        <% end %>
      </div>

      <div class="account-edit-cancel-and-submit-field">
        <div class="account-edit-cancel-field">
          <%= link_to "キャンセル", :back,class: "account-edit-cancel-link" %>
        </div>
        <div class="account-edit-submit-field">
          <%= f.submit "更新" ,class: "account-edit-submit"%>
      </div>
    <% end %>
  </div>
</main>
