<header>
    <%= render 'shared/homepage_header' %>
</header>
<main>
    <% if flash[:notice] %> 
        <div id="success-modal1" class="success-modal1 show"
            <div class="success-modal1-content">
                <p class="success-modal-message"><%= flash[:notice] %></p>
            </div>
        </div>
    <% end %>
    <div class ="homepage-top-view-first-content">
        <%= form_with(url: rooms_path, method: :get, local: true, class: "search-form") do %>
          <div class="search-fields">
            <!-- 住所検索 -->
            <div class="search-field">
                <%= label_tag :address, "エリア検索" %>
                <%= text_field_tag :address, params[:address], placeholder: "住所で検索", class: "search-input" %>
            </div> 
            <div class="search-field">
                <%= submit_tag "検索", class: "search-button" %>
            </div>
          </div>
      <% end %>
        <%= link_to "東京", rooms_path(address: "東京") %>
        <%= link_to "大阪", rooms_path(address: "大阪") %>
        <%= link_to "京都", rooms_path(address: "京都") %>
        <%= link_to "札幌", rooms_path(address: "札幌") %>
    </div>
</main>
<footer>
    <%= render "shared/homepage_footer" %>
</footer>

