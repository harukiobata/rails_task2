<header>
    <%= render 'shared/homepage_header' %>
</header>
<main>
    <%= link_to "戻る",:back ,class: "room-show-back-link" %>

    <div  class="room-show-main-contet">
        <div class="room-show-image-field">
            <%= image_tag(@room.image.attached? ? @room.image : "default_image.png", class: "default_image") %>
        </div>

        <div class="room-show-text-content">
            <div class="room-show-name-field">
                <span class="room-show-name"><%= @room.name %></span>
                <span class="room-show-price">¥<%= @room.price %>~</span>
            <div>

            <div class="room-show-address-field">
                <span class="room-show-address"><%= @room.address %></span>
                <span class="room-show-address-star"><%= raw ("<i class='fa fa-star'></i>" * 5) %></span>
            </div>

            <div class="room-show-description-field">
                <p class="room^show-description"><%= @room.description %></p>
            </div>

            <div class="room-show-reservation-form">
                <%= form_with model: @reservation, url: preview_reservations_path, method: :post do |form| %>
                <%= form.hidden_field :room_id, value: @room.id %> <!-- 部屋IDを隠しフィールドとして送信 -->
          
                    <div>
                        <%= form.label :check_in_date, "チェックイン日" %>
                        <%= form.date_field :check_in_date %>
                        <% if @reservation.errors[:check_in_date].any? %>
                            <div class="error-message">
                                <%= @reservation.errors.full_messages_for(:check_in_date).join(', ') %>
                            </div>
                        <% end %>
                    </div>

                    <div>
                        <%= form.label :check_out_date, "チェックアウト日" %>
                        <%= form.date_field :check_out_date %>
                        <% if @reservation.errors[:check_out_date].any? %>
                            <div class="error-message">
                                <%= @reservation.errors.full_messages_for(:check_out_date).join(', ') %>
                            </div>
                        <% end %>
                    </div>

                    <div>
                        <%= form.label :number_of_people, "人数" %>
                        <%= form.number_field :number_of_people %>
                        <% if @reservation.errors[:number_of_people].any? %>
                            <div class="error-message">
                                <%= @reservation.errors.full_messages_for(:number_of_people).join(', ') %>
                            </div>
                        <% end %>
                    </div>

                    <div>
                        <%= form.submit "確認する", class: "room-show-reservation-button" %>
                    </div>
                <% end %>
            </div>
        </div>
    </div>   
</main>
<footer>
    <%= render "shared/homepage_footer" %>
</footer>
