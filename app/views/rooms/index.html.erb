<header>
  <%= render "shared/homepage_header" %>
</header>

<main>
  <div class="room-index-main-content">
    <h2 class="room-index-main-heading">施設一覧</h2>

    <!-- 名前と詳細での検索 -->
    <div class="search-section">
    <%= form_with(url: rooms_path, method: :get, local: true, class: "search-form") do %>
      <div class="search-fields">
        <!-- 住所検索 -->
        <div class="search-field">
          <%= label_tag :address, "エリア検索" %>
          <%= text_field_tag :address, params[:address], placeholder: "住所で検索", class: "search-input" %>
        </div>

        <!-- 施設名・施設詳細検索 -->
        <div class="search-field">
          <%= label_tag :keyword, "キーワード検索" %>
          <%= text_field_tag :keyword, params[:keyword], placeholder: "施設名または施設詳細で検索", class: "search-input" %>
        </div>

        <!-- 検索ボタン -->
        <div class="search-field">
          <%= submit_tag "検索", class: "search-button" %>
        </div>
      </div>
    <% end %>
    </div>

    <!-- 絞り込んだ施設一覧 -->
    <div class="room-list">
      <h3>施設一覧 (計 <%= @room_count %> 件)</h3>
      <% if @rooms.any? %>
        <table class="room-table">
          <thead>
            <tr>
              <th>施設名</th>
              <th>詳細</th>
              <th>住所</th>
              <th>料金</th>
            </tr>
          </thead>
          <tbody>
            <% @rooms.each do |room| %>
              <tr>
                <td><%= link_to room.name, room_path(room) %></td> 
                <td><%= room.description %></td>
                <td><%= room.address %></td>
                <td><%= room.price %> 円</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p>該当する施設がありません。</p>
      <% end %>
    </div>

  </div>
</main>

<footer>
  <%= render "shared/homepage_footer" %>
</footer>
