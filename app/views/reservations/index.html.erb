<header>
    <%= render 'shared/homepage_header' %>
</header>
<main>

    <% if flash[:notice] %> 
        <div id="success-modal1" class="success-modal1 show"
            <div class="success-modal1-content">
                <p class="success-modal-message"><%= flash[:notice] %></p>
            </div>
        </div>
    <% end %>

    <div class="room-own-main-content">
        <div class="room-own-main-content-heading-field">
            <h3>予約済み一覧</h3>
        </div>
        <div class="room-own-content-table-lap">
            <table class ="room-own-content-table">
                <thead>
                    <tr> 
                        <th>画像</th>
                        <th>施設名</th>
                        <th>紹介文</th>
                        <th>合計額</th>
                        <th>checkin</th>
                        <th>checkout</th>
                        <th>予約確定日時</th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    <% @reservations.each do |reservation| %>
                        <tr>
                            <td><%= image_tag(reservation.room.image.attached? ? url_for(reservation.room.image) : "default_image.png", class: "room-own-image") %></td>
                            <td><%= link_to reservation.room.name, room_path(reservation.room) , class: "room-own-tbody-name" %></td> 
                            <td><%= tag.span reservation.room.description  ,class: "room-own-tbody-description" %></td>
                            <td><%= tag.span reservation.total_price,class: "room-own-tbody-price" %></td>
                            <td><%= tag.span reservation.check_in_date.strftime("%Y/%m/%d"),class: "room-own-tbody-create-day" %></td>
                            <td><%= tag.span reservation.check_out_date.strftime("%Y/%m/%d") %></td>
                            <td><%= tag.span reservation.created_at.strftime("%Y/%m/%d %H:%M") %></td>
                            <td><%= link_to "編集", edit_reservation_path(reservation), class: "reservation-index-to-edit" %></td>
                            <td><%= link_to "削除", '#', class: "open-reservation-modal", data: { reservation_id: reservation.id, room_name: reservation.room.name, room_price: reservation.room.price, 
                                room_image: reservation.room.image.attached? ? url_for(reservation.room.image) : asset_path('default_image.png'),check_in_date: reservation.check_in_date,
                                check_out_date: reservation.check_out_date,number_of_people: reservation.number_of_people} %></td>
                        </tr>
                    <% end %>
                </tbody>   
            </table>
        </div>
    </div>

        <!-- 予約削除確認モーダル -->
    <div class="reservation-modal-delete" tabindex="-1" id="reservationModalDelete" style="display: none;">
        <div class="reservation-modal-content">
            <div class="reservation-modal-header">
                <h4 class="reservation-modal-title">この予約を削除しますか？</h4>
            </div>
            <div class="reservation-modal-body">
                <p class="reservation-modal-body-message">
                    <img id="reservation-room-image" class="reservation-room-image">
                    <span id="reservation-room-name"></span><span id="reservation-room-price"></span><br>
                    <span id="reservation-check-in-date"></span>
                    <span id="reservation-check-out-date"></span>
                    <span id="reservation-number-of-people"></span>
                </p>
                <p class="reservation-modal-body-message2">よろしければ削除ボタンをクリックしてください</p>
            </div>
            <div class="reservation-modal-footer">
                <button type="button" id="reservation-confirm-delete" class="reservation-btn-delete">削除</button>
                <button type="button" id="reservation-cancel-delete-button" class="reservation-btn-cancel">キャンセル</button>
        </div>
    </div>
</div>

</main>
<footer>
  <%= render 'shared/homepage_footer' %>
</footer>
