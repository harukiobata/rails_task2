<header>
  <%= render 'shared/homepage_header' %>
</header>

<main>
  <%= link_to "戻る", edit_reservation_path(@reservation), class: "back-link" %>

  <div class="preview-container">
    <h2>予約内容確認</h2>

    <!-- 予約情報の確認 -->
    <div class="preview-info">
      <p>部屋名: <%= @room.name %></p>
      <p>チェックイン日: <%= @reservation.check_in_date.strftime("%Y/%m/%d") %></p>
      <p>チェックアウト日: <%= @reservation.check_out_date.strftime("%Y/%m/%d") %></p>
      <p>宿泊人数: <%= @reservation.number_of_people %> 名</p>
      <p>宿泊日数: <%= @stay_duration %> 日</p>
      <p>料金: ¥<%= @total_price %></p>
    </div>

    <!-- 確認ボタン -->
    <%= form_with model: @reservation, url: reservation_path(@reservation), method: :patch do |form| %>
      <%= form.hidden_field :check_in_date, value: @reservation.check_in_date %>
      <%= form.hidden_field :check_out_date, value: @reservation.check_out_date %>
      <%= form.hidden_field :number_of_people, value: @reservation.number_of_people %>

      <div class="preview-action-buttons">
        <%= form.submit '予約を確定する', class: 'confirm-button' %>
        <%= link_to '修正する', edit_reservation_path(@reservation), class: 'edit-link' %>
      </div>
    <% end %>
  </div>
</main>

<footer>
  <%= render 'shared/homepage_footer' %>
</footer>
